{
  "formulario": "formulario-producto",
  "titulo": "Detalles del producto",
  "campos": [
    {
      "id": "nombre",
      "nombre": "nombre",
      "etiqueta": "Nombre del producto *",
      "tipo": "text",
      "placeholder": "Ej: Capuchino Grande",
      "requerido": true,
      "elemento_error": "error-nombre",
      "validacion": {
        "tipo_dato": "string",
        "min_length": 3,
        "max_length": 100,
        "regex": "^[\\p{L}0-9\\s\\.\\-]+$",
        "mensajes": {
          "tipo": "Introduce texto para el nombre.",
          "vacio": "Escribe el nombre del producto.",
          "longitud": "El nombre del producto debe tener entre 3 y 100 caracteres.",
          "regex": "El nombre contiene caracteres no permitidos."
        }
      }
    },
    {
      "id": "descripcion",
      "nombre": "descripcion",
      "etiqueta": "Descripción *",
      "tipo": "textarea",
      "filas": 3,
      "placeholder": "Ej: Café expreso con leche vaporizada...",
      "requerido": true,
      "elemento_error": "error-descripcion",
      "validacion": {
        "tipo_dato": "string",
        "min_length": 5,
        "max_length": 500,
        "regex": "^[\\p{L}0-9\\s\\.\\-]+$",
        "mensajes": {
          "tipo": "La descripción debe ser texto.",
          "vacio": "Escribe una descripción para el producto.",
          "longitud": "La descripción debe tener entre 5 y 500 caracteres.",
          "regex": "La descripción contiene caracteres no permitidos."
        }
      }
    },
    {
      "id": "precio",
      "nombre": "precio",
      "etiqueta": "Precio ($) *",
      "tipo": "number",
      "paso": "0.01",
      "min": "0.01",
      "placeholder": "Ej: 3.50",
      "requerido": true,
      "elemento_error": "error-precio",
      "validacion": {
        "min_valor": 0.01,
        "max_valor": 100000,
        "mensajes": {
          "invalido": "Introduce un precio válido para el producto.",
          "minimo": "El precio debe ser mayor a cero.",
          "maximo": "El precio excede el límite máximo permitido."
        }
      }
    },
    {
      "id": "categoria",
      "nombre": "categoria",
      "etiqueta": "Categoría *",
      "tipo": "select",
      "requerido": true,
      "elemento_error": "error-categoria",
      "opciones": [
        { "valor": "", "texto": "Selecciona una categoría", "deshabilitado": true, "seleccionado": true },
        { "valor": "Bebida", "texto": "Bebida" },
        { "valor": "Comida", "texto": "Comida" },
        { "valor": "Postre", "texto": "Postre" }
      ],
      "validacion": {
        "permitidos": ["Bebida", "Comida", "Postre"],
        "mensaje": "Selecciona una categoría válida del menú."
      }
    },
    {
      "id": "imagen",
      "nombre": "imagen",
      "etiqueta": "Imagen del producto",
      "tipo": "file",
      "aceptar": "image/*",
      "ayuda": "Sube una foto atractiva (JPG, PNG)."
    }
  ],
  "acciones": {
    "cancelar": {
      "id": "btn-cancelar",
      "tipo": "button",
      "texto": "Cancelar"
    },
    "guardar": {
      "id": "btn-guardar",
      "tipo": "submit",
      "texto": "Guardar producto"
    }
  }
}
